// Managed by xp-ops (xp init)
// Compatibility supplement for systems that expose systemd unit/verb polkit details.
// The primary systemd Web upgrade trigger is /usr/local/libexec/xp-upgrade-trigger
// plus /etc/sudoers.d/91-xp-upgrade.
polkit.addRule(function(action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units") {
    return null;
  }
  if (!subject || subject.user != "xp") {
    return null;
  }
  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (unit == "xp-upgrade.service" && verb == "start") {
    return polkit.Result.YES;
  }
  return null;
});
