[Unit]
Description=xp web-triggered upgrade runner
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=XP_DATA_DIR=/var/lib/xp/data
EnvironmentFile=-/etc/xp/xp.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/xp-ops _upgrade-runner --data-dir "${XP_DATA_DIR:-/var/lib/xp/data}"'
